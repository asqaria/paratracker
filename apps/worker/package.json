{
  "name": "@skyline/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --config ../../vitest.config.ts --project @skyline/worker"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@photostructure/tz-lookup": "^11.7.0",
    "@skyline/analysis": "workspace:*",
    "@skyline/core": "workspace:*",
    "@skyline/db": "workspace:*",
    "@skyline/parsing": "workspace:*",
    "@skyline/track-format": "workspace:*",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
