# Прод-окружение Skyline (пример): скопировать в /root/projects/skyline/.env на сервере.
# Пароли — длинные случайные: openssl rand -hex 24. В git этот файл с реальными
# значениями не попадает (.env в .gitignore).

POSTGRES_USER=skyline
POSTGRES_PASSWORD=
POSTGRES_DB=skyline
DATABASE_URL=postgres://skyline:<POSTGRES_PASSWORD>@postgres:5432/skyline

MINIO_ROOT_USER=skyline
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=skyline
S3_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
S3_BUCKET=skyline
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=info

# Esri World Imagery через серверный прокси: ключ ArcGIS только здесь, во фронт
# не попадает. Пусто — кнопки Esri в просмотрщике не будет.
ARCGIS_API_KEY=
ARCGIS_TILE_URL=https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# Сеть внешнего прокси с HTTPS, к которой подключается web.
HTTPS_NETWORK=gateapp_default
