# Фронт Skyline внутри своего контейнера. HTTPS и домен — на внешнем прокси
# (на сервере — Caddy проекта GateApp), здесь только HTTP на :80.
{
	admin off
	auto_https off
}

:80 {
	encode gzip

	# API и поток статусов обработки (SSE): без буферизации, иначе события
	# прогресса приходят пачкой в конце. Имя skyline-api, а не api: web сидит ещё
	# и в сети внешнего прокси, где имя api может принадлежать соседнему проекту.
	handle /api/* {
		reverse_proxy skyline-api:3000 {
			flush_interval -1
		}
	}

	# Ссылка «поделиться» (задача 3.8): мессенджеру — страница с превью полёта,
	# человеку — переадресация в просмотрщик. Отвечает API.
	handle /s/* {
		reverse_proxy skyline-api:3000
	}

	handle {
		root * /srv
		# Файлы с хешем в имени не меняются — кешируются надолго; index.html — нет,
		# иначе после деплоя браузер держал бы старую версию.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		# Остальное без хеша (index.html, демо-трек, файлы Cesium) — с проверкой
		# свежести по ETag: без Cache-Control браузер сам решал, сколько держать
		# старую версию после выкладки.
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		file_server
	}
}
