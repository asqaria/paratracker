# Скопируй в .env. Значения — для локального окружения из infra/docker-compose.yml:
#   docker compose --env-file .env -f infra/docker-compose.yml up -d --wait
# Секреты прода сюда не пишутся.

# --- docker compose ---
POSTGRES_USER=skyline
POSTGRES_PASSWORD=skyline
POSTGRES_DB=skyline
POSTGRES_PORT=5432
MINIO_ROOT_USER=skyline
MINIO_ROOT_PASSWORD=skyline-dev-secret

# --- packages/db, apps/api ---
DATABASE_URL=postgres://skyline:skyline@127.0.0.1:5432/skyline

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=skyline
S3_SECRET_ACCESS_KEY=skyline-dev-secret
S3_BUCKET=skyline
S3_FORCE_PATH_STYLE=true

# --- apps/api, apps/web (dev-прокси /api) ---
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info

# --- Esri World Imagery через серверный прокси (ТЗ §4.4.1) ---
# Ключ ArcGIS Location Platform. В бандл фронта не попадает: тайлы идут через apps/api.
# Пусто — подложка Esri недоступна, остаётся Sentinel-2.
ARCGIS_API_KEY=
ARCGIS_TILE_URL=https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}

# --- apps/web: источники рельефа и подложки (ТЗ §4.4). Хардкода адресов в коде нет ---
VITE_TERRAIN_URL=https://terrain.reearth.land/cesium-mesh/ellipsoid
VITE_IMAGERY_WMTS_URL=https://tiles.maps.eox.at/wmts/1.0.0/{layer}/default/WGS84/{TileMatrix}/{TileRow}/{TileCol}.jpg
VITE_IMAGERY_WMTS_LAYER=s2cloudless-2025
# Путь прокси нашего API; Esri появляется в переключателе только если он задан.
VITE_ESRI_TILE_URL=/api/v1/tiles/esri/{z}/{y}/{x}
