# Скопируй в .env. Значения — для локального окружения из infra/docker-compose.yml:
#   docker compose --env-file .env -f infra/docker-compose.yml up -d --wait
# Секреты прода сюда не пишутся.

# --- docker compose ---
POSTGRES_USER=skyline
POSTGRES_PASSWORD=skyline
POSTGRES_DB=skyline
POSTGRES_PORT=5432
MINIO_ROOT_USER=skyline
MINIO_ROOT_PASSWORD=skyline-dev-secret

# --- packages/db, apps/api ---
DATABASE_URL=postgres://skyline:skyline@127.0.0.1:5432/skyline

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=skyline
S3_SECRET_ACCESS_KEY=skyline-dev-secret
S3_BUCKET=skyline
S3_FORCE_PATH_STYLE=true

# --- apps/api, apps/web (dev-прокси /api) ---
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
